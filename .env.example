# Exemple local sans secret. Les valeurs réelles sont injectées par l'environnement.
APP_ENV=local
TARGET_FINGERPRINT=local-mbs-v1
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
# Worker d'effets différés (story 1.3). Optionnelles au build, obligatoires à l'exécution du worker.
# DEFERRED_EFFECTS_WORKER_SECRET n'est PAS SUPABASE_ANON_KEY.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DEFERRED_EFFECTS_WORKER_SECRET=replace-with-local-worker-secret
# Observabilité (story 1.4). Clé HMAC-SHA256 de pseudonymisation des identifiants d'acteur.
# Optionnelle au build, OBLIGATOIRE dès qu'on pseudonymise : aucun repli sur un hachage nu.
# 32 caractères minimum, distincte de SUPABASE_ANON_KEY et de DEFERRED_EFFECTS_WORKER_SECRET.
OBSERVABILITY_PSEUDONYM_KEY=replace-with-local-pseudonym-key-32-chars-minimum
