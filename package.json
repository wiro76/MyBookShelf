{
  "name": "my-bookshelf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node node_modules/typescript7/bin/tsc --project tsconfig.typecheck.json --noEmit",
    "test": "npm run ci:unit && npm run ci:integration && npm run test:e2e",
    "test:e2e": "playwright test",
    "ci:static": "npm run build",
    "ci:lint": "npm run lint",
    "ci:types": "npm run typecheck",
    "ci:unit": "node --test tests/unit/*.test.mjs",
    "ci:integration": "node --test tests/integration/*.test.mjs",
    "ci:database": "node scripts/run-database-gates.mjs",
    "ci:e2e": "playwright test --workers=1",
    "ci:budgets": "playwright test tests/e2e/ux-budgets.spec.ts --workers=1",
    "ci:environment": "node scripts/verify-environment-isolation.mjs",
    "ci:mutations": "node scripts/verify-ci-mutations.mjs",
    "ci:all": "npm run ci:lint && npm run ci:types && npm run ci:unit && npm run ci:integration && npm run ci:environment && npm run ci:database && npm run ci:e2e && npm run ci:budgets && npm run ci:static && npm run ci:mutations"
  },
  "dependencies": {
    "next": "16.2.12",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@axe-core/playwright": "4.12.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "6.0.2",
    "typescript7": "npm:typescript@7.0.2"
  },
  "overrides": {
    "@emnapi/core": "1.11.1",
    "@emnapi/wasi-threads": "1.2.2",
    "postcss": "8.5.18",
    "sharp": "0.35.3"
  }
}
